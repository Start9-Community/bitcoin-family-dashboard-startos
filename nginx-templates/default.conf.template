map $http_x_pexels_key $pexels_auth_header {
    default $http_x_pexels_key;
    ""      "";
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /config.json {
        alias /data/config.json;
        default_type application/json;
        add_header Cache-Control "no-store";
    }

    # Uploaded profile pictures, written by the page through /api/avatar and
    # served straight from the package volume. `^~` keeps the static-asset
    # regex below from hijacking these paths; URLs are versioned with ?v=, so
    # the response can be cached hard.
    location ^~ /avatars/ {
        alias /data/avatars/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /api/cbstats {
        proxy_pass https://api.exchange.coinbase.com/products/BTC-USD/stats;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_read_timeout 15s;
        proxy_set_header Host api.exchange.coinbase.com;
    }

    location /api/bn/ {
        proxy_pass https://data-api.binance.vision/api/v3/;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_read_timeout 15s;
        proxy_set_header Host data-api.binance.vision;
    }

    location /api/bc/ {
        proxy_pass https://api.blockchain.info/charts/;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_read_timeout 15s;
        proxy_set_header Host api.blockchain.info;
    }

    # The browser sends the key it read from config.json as X-Pexels-Key; the
    # map above turns that into the Authorization header Pexels expects.
    location /api/pexels/ {
        proxy_pass https://api.pexels.com/v1/;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_read_timeout 15s;
        proxy_set_header Host api.pexels.com;
        proxy_set_header Authorization $pexels_auth_header;
    }

    location = /api/wallet-balance {
        proxy_pass http://127.0.0.1:8090/api/wallet-balance;
        proxy_read_timeout 300s;
        proxy_set_header Host localhost;
    }

    # Profile-picture list (JSON) and upload (JPEG body) live in wallet-helper.
    location = /api/avatars {
        proxy_pass http://127.0.0.1:8090/api/avatars;
        proxy_read_timeout 15s;
        proxy_set_header Host localhost;
    }

    location = /api/avatar {
        proxy_pass http://127.0.0.1:8090/api/avatar;
        proxy_read_timeout 15s;
        proxy_set_header Host localhost;
        client_max_body_size 512k;
    }

    location /api/price {
        proxy_pass ${PRICE_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_read_timeout 15s;
        proxy_set_header Host ${PRICE_HOST};
    }

    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-store";
    }
}
